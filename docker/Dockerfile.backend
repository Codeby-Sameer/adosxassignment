# Backend Dockerfile for AdosX Reconciliation Backend
FROM python:3.12-slim

# Install uv for fast, deterministic dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set working directory inside container
WORKDIR /app

# Ensure standard environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=0

# Copy dependency definition files
COPY backend/pyproject.toml backend/uv.lock /app/backend/

# Install python dependencies using uv
WORKDIR /app/backend
RUN uv sync --frozen

# Copy backend code and data files
COPY backend/ /app/backend/
COPY data/ /app/data/

# Expose Django port
EXPOSE 8000

# Run migrations, import CSVs, and start server
CMD ["sh", "-c", "uv run python manage.py migrate && uv run python manage.py import_csv && uv run python manage.py runserver 0.0.0.0:8000"]
